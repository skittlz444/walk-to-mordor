{
  "testEnvironment": "node",
  "collectCoverage": true,
  "coverageDirectory": "coverage",
  "coverageReporters": [
    "text",
    "text-summary",
    "html",
    "lcov",
    "json"
  ],
  "collectCoverageFrom": [
    "src/**/*.{js,ts}",
    "!src/**/*.d.ts",
    "!src/**/node_modules/**",
    "!coverage/**"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "testMatch": [
    "**/tests/**/*.test.js",
    "**/tests/**/*.test.ts",
    "**/__tests__/**/*.js"
  ],
  "verbose": true,
  "setupFilesAfterEnv": [],
  "transform": {
    "^.+\\.ts$": ["ts-jest", {
      "tsconfig": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true
      }
    }]
  },
  "moduleFileExtensions": ["ts", "js", "json"],
  "extensionsToTreatAsEsm": []
}
