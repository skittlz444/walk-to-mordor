{
	"compatibility_date": "2025-04-01",
	"main": "src/index.ts",
	"name": "walk-to-mordor",
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "walk-to-mordor",
			"database_id": "$DATABASE_ID"
		}
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
  "routes": [
    { "pattern": "*haydencarson.com/wtm*", "zone_name": "haydencarson.com" }
  ],
  "secrets":[
	"DATABASE_ID"
  ]
}