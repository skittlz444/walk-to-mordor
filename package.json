{
  "name": "walk-to-mordor",
  "description": "Cloudflare's native serverless SQL database.",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skittlz444/walk-to-mordor.git"
  },
  "cloudflare": {
    "label": "Worker + D1 Database",
    "products": [
      "Workers",
      "D1"
    ],
    "categories": [
      "storage"
    ],
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/c6fc5da3-1e0a-4608-b2f1-9628577ec800/public",
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ],
    "docs_url": "https://developers.cloudflare.com/d1/",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/cb7cb0a9-6102-4822-633c-b76b7bb25900/public",
    "publish": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "jest": "^30.5.1",
    "jest-environment-miniflare": "^2.14.4",
    "jest-junit": "^17.0.0",
    "pnpm": "^11.25.0",
    "sharp": "^0.35.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.129.0"
  },
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "tsc && wrangler deploy --dry-run",
    "check:assets": "node .github/scripts/check-asset-count.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run build:client && node public/js/update-cache-version.js && npm run build:manifest",
    "build:manifest": "node scripts/generate-image-manifest.js",
    "build:client": "cd client && vite build",
    "dev:client": "cd client && vite build --watch",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build:sw:reset && npm run seedLocalD1 && npm run build:client && concurrently --kill-others-on-fail --names \"vite,wrangler\" --prefix-colors \"cyan,yellow\" \"npm run dev:client\" \"wrangler dev --var ALLOW_TEST_AUTH:true\"",
    "dev:ci": "wrangler dev --var ALLOW_TEST_AUTH:true",
    "predeploy": "wrangler d1 migrations apply DB --remote",
    "seedLocalD1": "wrangler d1 migrations apply DB --local",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:legacy:coverage": "jest --coverage --config jest.config.legacy.json --passWithNoTests",
    "test:ui": "npm run build:client && node public/js/reset-cache-version.js && playwright test --project=chromium",
    "test:ui:all": "node scripts/test-ui-all-browsers.js",
    "test:ui:headed": "npm run build:client && node public/js/reset-cache-version.js && playwright test --headed",
    "test:ui:report": "playwright show-report",
    "test:client": "vitest run --root client",
    "test:client:watch": "vitest --root client",
    "test:client:coverage": "vitest run --coverage --root client",
    "build:sw": "node public/js/update-cache-version.js",
    "build:sw:reset": "node public/js/reset-cache-version.js",
    "optimize:images": "node scripts/optimize-images.js && npm run build:manifest",
    "tile:map": "node scripts/tile-map-image.js"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@preact/signals": "^2.11.1",
    "dompurify": "^3.4.14",
    "hono": "^4.13.5",
    "konva": "^10.3.2",
    "marked": "^18.0.11",
    "preact": "^10.29.8"
  }
}
