{
  "name": "walk-to-mordor",
  "description": "Cloudflare's native serverless SQL database.",
  "private": true,
  "cloudflare": {
    "label": "Worker + D1 Database",
    "products": [
      "Workers",
      "D1"
    ],
    "categories": [
      "storage"
    ],
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/c6fc5da3-1e0a-4608-b2f1-9628577ec800/public",
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ],
    "docs_url": "https://developers.cloudflare.com/d1/",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/cb7cb0a9-6102-4822-633c-b76b7bb25900/public",
    "publish": true
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "pnpm": "^10.27.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "typescript": "5.9.3",
    "wrangler": "^4.54.0"
  },
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "tsc && wrangler deploy --dry-run",
    "build": "node public/js/update-cache-version.js",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build:sw:reset &&pnpm seedLocalD1 && wrangler dev",
    "predeploy": "wrangler d1 migrations apply DB --remote",
    "seedLocalD1": "wrangler d1 migrations apply DB --local",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ui": "playwright test tests/ui.success.spec.js tests/ui.edge-cases.spec.js --reporter=list",
    "test:ui:headed": "playwright test tests/ui.success.spec.js tests/ui.edge-cases.spec.js --headed",
    "test:ui:report": "playwright show-report",
    "build:sw": "node public/js/update-cache-version.js",
    "build:sw:reset": "node public/js/reset-cache-version.js"
  }
}
